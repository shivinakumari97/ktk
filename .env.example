# ─────────────────────────────────────────────────────────────────────────────
# ktk Political Monitor — environment configuration
# Copy to `.env` and fill in. Everything is optional except where noted; the app
# runs in a safe "mock" mode when real provider keys are absent, so you can try
# the full pipeline with zero spend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---
PORT=3000
# SQLite file location. Use ":memory:" for ephemeral runs/tests.
DATABASE_PATH=./data/ktk.sqlite
# IANA timezone used for quiet-hours math and display. Watchlist quiet_hours are
# interpreted in this zone.
TZ=Asia/Kolkata
# Cron expression for the polling worker (default: every 15 minutes).
POLL_CRON=*/15 * * * *
# Set to "false" to start the web server only and never auto-poll.
SCHEDULER_ENABLED=true

# --- Assessor (LLM relevance + content extraction) ---
# If ANTHROPIC_API_KEY is unset, the app uses a deterministic keyword-based mock
# assessor so the pipeline still runs end-to-end.
ANTHROPIC_API_KEY=
# Model for assessment. Haiku is cheapest and fine for triage; bump to
# claude-sonnet-4-6 for harder extraction.
ASSESSOR_MODEL=claude-haiku-4-5
ASSESSOR_MAX_TOKENS=1500

# --- News sources ---
# NewsAPI.org key (optional). Without it the NewsAPI source is skipped.
NEWSAPI_KEY=
# Comma-separated RSS feed URLs (optional; can also be managed in the dashboard).
RSS_FEEDS=

# --- Twilio notifications ---
# Without these, notifiers run in mock mode and just log what *would* be sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender (E.164), e.g. +14155551234
TWILIO_SMS_FROM=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox or approved sender)
TWILIO_WHATSAPP_FROM=
# Your destination number(s), comma-separated, E.164: +9198xxxxxxxx
ALERT_TO=
