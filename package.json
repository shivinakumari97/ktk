{
  "name": "ktk-political-monitor",
  "version": "1.0.0",
  "description": "Pluggable political/news event monitor with relevance-scored SMS/WhatsApp alerts. First use case: Karnataka state politics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "worker": "tsx src/scheduler/run-once.ts",
    "seed": "tsx src/config/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "twilio": "^5.4.0",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^3.0.4"
  }
}
